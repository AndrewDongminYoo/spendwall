# Keep a private copy of this template; never commit real credentials.
# Docker Compose loads its default environment file automatically.
# Node entrypoints require exported variables or an explicit --env-file argument.
# Supply only the variables required by each process.

# Local Docker Compose database. Replace the password in your private copy.
POSTGRES_DB=spendwall
POSTGRES_USER=spendwall
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# PayPal sandbox integrations: proxy, sandbox checks and webhook receiver.
# Keep these credentials outside the agent and the hosted read-only service.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Local proxy listening port (default: 3001).
SPENDWALL_PROXY_PORT=3001

# Audit verification only: PostgreSQL URL with permission to read audit data.
# This is not a shared database setting for every entrypoint.
AUDIT_DATABASE_URL=

# Optional Claude live demo; recorded demos do not require a model API key.
ANTHROPIC_API_KEY=

# Optional hosted read-only dashboard API; see docs/hosting.md for provisioning.
# Configure these separately in the service environment, without PayPal/model keys.
# Use an exact HTTPS origin without a trailing slash or path.
# SPENDWALL_PUBLIC_ORIGIN=https://dashboard.example.invalid
# Use the restricted reader's PostgreSQL URL, without query parameters/fragments.
# SPENDWALL_DASHBOARD_DATABASE_URL=
# Absolute path to the private JSON configuration.
# SPENDWALL_DASHBOARD_CONFIG=/etc/secrets/dashboard.json
# PORT=10000

# Optional terminal output preference. Presence disables demo colors, even if empty.
# NO_COLOR=1

# PostgreSQL test runners create a disposable database and inject
# AUDIT_TEST_DATABASE_URL; normal test commands need no manual setting here.
# Test/runtime internals (PGOPTIONS, CLAUDE_CONFIG_DIR, SPENDWALL_REAL_DOCKER,
# SPENDWALL_COLD_READY) are intentionally not application configuration.
# Webhook-specific settings use a private --config JSON file; see docs/webhooks.md.

{
  "name": "spendwall",
  "version": "1.0.0",
  "description": "A deterministic payment policy firewall for AI agents.",
  "scripts": {
    "lint": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test tests/*.test.mjs && pnpm test:audit:postgres",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "hooks:install": "trunk git-hooks sync",
    "mcp:dump": "node scripts/dump-paypal-mcp-tools.mjs",
    "seed": "node scripts/seed.mjs",
    "proxy": "node apps/firewall/src/index.ts",
    "proxy:check": "node scripts/proxy-smoke.mjs",
    "proxy:refund": "node scripts/proxy-smoke.mjs --refund",
    "audit:verify": "node scripts/audit-verify.mjs",
    "test:audit:postgres": "node scripts/test-audit-postgres.mjs",
    "test:approval-api": "node scripts/test-audit-postgres.mjs --approval-api",
    "demo": "node apps/agent-demo/src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
